# --- Database: SQLite by default; switch to PostgreSQL for production ---
# DATABASE_URL=postgresql+psycopg2://phish:phish@localhost:5432/cphishtank
DATABASE_URL=sqlite:///./cphishtank.db

SECRET_KEY=
TOKEN_EXPIRE_MINUTES=720
REMEMBER_TOKEN_EXPIRE_DAYS=30
# Comma-separated emails that become admins when they register
ADMIN_EMAILS=admin@example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEV_MODE=false

# Gmail SMTP (use a Google App Password, never your normal account password)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_APP_PASSWORD=
MAIL_FROM_NAME=

# --- Optional live URL checks (all off / empty by default) ---
ENABLE_WHOIS=false
ENABLE_REDIRECT_CHECK=false
GOOGLE_SAFE_BROWSING_KEY=
VIRUSTOTAL_API_KEY=
